# Copy this file to .env and fill in the values.

# --- Database (Supabase) ---
# Supabase dashboard -> your project -> Connect -> ORMs -> Prisma.
# Pooled connection (Supavisor, transaction mode, port 6543) used by the app at runtime.
# Use this on Vercel. For local development, setting DATABASE_URL to the same value as
# DIRECT_URL (port 5432) is ~5x faster, because transaction mode adds round trips per query.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection (port 5432) used by Prisma Migrate.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth ---
NEXTAUTH_SECRET="generate-with: npx auth secret  (or any long random string)"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Code required to register an admin account
ADMIN_CODE=""

# --- Cron ---
# Protects /api/cron/keep-alive. Vercel sends it automatically to cron requests.
CRON_SECRET="any-long-random-string"

# --- Email (verification emails via nodemailer) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_SECRET=""

# --- Paystack (payments) ---
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLISHABLE_KEY=""

# --- Optional ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
IPINFO_TOKEN=""
WEATHER_API_KEY=""
